{
  "name": "@origamix/shared",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./*": {
        "types": "./dist/*.d.mts",
        "import": "./dist/*.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "pnpm --dir ../.. exec tsup --config packages/shared/tsup.config.ts",
    "pack:npm": "pnpm pack --pack-destination ../../release/npm"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
