  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsup": "^8.5.0",
    "@origamix/shared": "workspace:*",
    "react-dom": "^19.2.8",
    "@types/react-dom": "19.2.5",
    "@types/node": "^24.13.3",
    "tsx": "4.23.13"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "sideEffects": false
