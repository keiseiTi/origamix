{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "antd/editor": ["./antd/editor.ts"],
      "antd/manifest": ["./antd/manifest.ts"],
      "antd/runtime": ["./antd/runtime.ts"],
      "antd/validation": ["./antd/validation.ts"],
      "@": [
        "./src/index.ts"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "antd",
    "components",
    "antd/interfaces",
    "utils",
    "*.ts",
    "src",
    "test",
    "scripts"
  ]
}
