{
  "name": "@origamix/materials",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./antd/manifest": {
      "types": "./dist/public/antd/manifest.d.ts",
      "import": "./dist/public/antd/manifest.js"
    },
    "./antd/runtime": {
      "types": "./dist/public/antd/runtime.d.ts",
      "import": "./dist/public/antd/runtime.js"
    },
    ".": {
      "types": "./dist/internal/index.d.ts",
      "import": "./dist/internal/index.js"
    },
    "./antd/editor": {
      "types": "./dist/internal/antd/editor.d.ts",
      "import": "./dist/internal/antd/editor.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./antd/runtime": {
        "types": "./dist/public/antd/runtime.d.ts",
        "import": "./dist/public/antd/runtime.js"
      },
      "./antd/manifest": {
        "types": "./dist/public/antd/manifest.d.ts",
        "import": "./dist/public/antd/manifest.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm manifest:generate && tsc --noEmit -p tsconfig.json",
    "test": "pnpm manifest:generate && vitest run",
    "build": "pnpm manifest:generate && tsdown",
    "pack:npm": "tsx ../../scripts/pack-public.ts materials",
    "prepack": "node -e \"throw new Error('Use pnpm pack:npm to prepare isolated public artifacts')\"",
    "manifest:generate": "node --import tsx scripts/generate-manifest.ts",
    "manifest:watch": "node --import tsx scripts/generate-manifest.ts --watch",
    "manifest:check": "node --import tsx scripts/generate-manifest.ts --check"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "antd": "^6.0.0",
    "react": "^19.2.8",
    "tsdown": "^0.23.3",
    "@origamix/shared": "workspace:*",
    "@origamix/ui": "workspace:*",
    "@origamix/runtime": "workspace:*",
    "tsx": "4.23.13",
    "@types/node": "^24.13.3",
    "prettier": "^3.9.6"
  },
  "peerDependencies": {
    "antd": "^6",
    "react": "^19",
    "@origamix/ui": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@origamix/ui": {
      "optional": true
    }
  }
}
