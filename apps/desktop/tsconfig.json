{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"] },
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": [
      "node",
      "electron"
    ]
  },
  "include": [
    "src",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.cts"
  ]
}
