{
  "name": "@origamix/server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./runtime": {
      "types": "./src/server.ts",
      "default": "./dist/runtime.cjs"
    },
    "./tooling": {
      "types": "./src/tooling.ts",
      "default": "./dist/tooling.cjs"
    },
    "./utility": "./dist/server.cjs",
    "./build": "./scripts/build.ts",
    "./development": "./scripts/dev-supervisor.ts",
    "./template": {
      "types": "./src/templates/copy-template.ts",
      "default": "./dist/template.cjs"
    },
    "./template-artifact": {
      "types": "./scripts/prepare-template-artifact.ts",
      "default": "./scripts/prepare-template-artifact.ts"
    },
    "./development-libraries": "./scripts/development-libraries.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm check:database-schema && pnpm test:architecture && vitest run --exclude test/eslint-boundaries.test.ts",
    "test:architecture": "tsx --test test/eslint-boundaries.test.ts",
    "test:template": "tsx test/test-template.ts",
    "test:dev": "tsx test/test-development.ts",
    "gate:agent": "tsx scripts/gate-agent.ts",
    "build": "tsx scripts/build.ts",
    "dev": "tsx scripts/dev.ts",
    "check:database-schema": "tsx scripts/check-database-schema.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@origamix/materials": "workspace:*",
    "@origamix/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "ajv": "^8.20.0",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.12.1",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "0.31.10",
    "tsup": "^8.5.0",
    "tsx": "4.23.13",
    "eslint": "^10.9.0",
    "typescript-eslint": "^8.67.0"
  }
}
