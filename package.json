{
  "name": "origamix",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": { "node": ">=24.13.0 <25", "pnpm": ">=10.33.0 <11" },
  "description": "A low-code agent platform and visual builder",
  "author": "yupeilin <yuchacha250@gmail.com>",
  "scripts": {
    "dev": "pnpm --filter @origamix/desktop dev",
    "dev:web": "pnpm --filter @origamix/app dev",
    "build": "pnpm -r --filter \"!@origamix/desktop\" build && pnpm --filter @origamix/desktop build:assemble",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "package": "pnpm lint && pnpm typecheck && pnpm test && pnpm --filter @origamix/desktop package"
  },
  "keywords": [
    "lowCode",
    "editor",
    "visual config",
    "ai first"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
