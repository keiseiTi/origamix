{
  "name": "@origamix/desktop",
  "version": "1.0.0",
  "description": "Origamix desktop application",
  "author": "yupeilin <yuchacha250@gmail.com>",
  "type": "module",
  "private": true,
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:main": "tsx test/test-electron.ts",
    "evaluate:agent": "tsx test/evaluate-agent.ts",
    "test:resources": "tsx test/test-electron.ts --resources",
    "build": "tsx scripts/build.ts",
    "package": "pnpm package:mac",
    "package:dir": "electron-builder --config electron-builder.yml --mac --arm64 --dir --publish never",
    "package:mac": "electron-builder --config electron-builder.yml --mac --arm64 --publish never",
    "test:dev": "tsx test/test-development.ts"
  },
  "dependencies": {
    "@origamix/server": "workspace:*",
    "@origamix/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.0",
    "tsdown": "^0.23.3",
    "tsx": "4.23.13"
  }
}
