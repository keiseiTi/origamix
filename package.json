{
  "name": "origamix",
  "version": "1.0.0",
  "private": true,
  "description": "A low-code agent platform and visual builder",
  "author": "yupeilin <yuchacha250@gmail.com>",
  "scripts": {
    "dev": "pnpm --filter @origamix/desktop dev",
    "dev:web": "pnpm --filter @origamix/app dev",
    "build": "pnpm build:libs && pnpm --filter @origamix/app build && pnpm --filter @origamix/server build:assemble && pnpm --filter @origamix/desktop build:assemble",
    "build:web": "pnpm build:libs && pnpm --filter @origamix/app build",
    "build:libs": "pnpm --filter @origamix/shared --filter @origamix/runtime --filter @origamix/materials build",
    "format": "prettier --write \"{packages, apps}/**/*.{js,jsx,ts,tsx,json,mjs,css,md}\"",
    "hooks:install": "lefthook install",
    "hooks:run": "lefthook run pre-commit",
    "lint": "eslint scripts && pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:architecture && pnpm -r test",
    "gate:internal": "pnpm --filter @origamix/server gate:agent",
    "package:npm": "pnpm build:libs && pnpm --filter @origamix/shared --filter @origamix/runtime --filter @origamix/materials run pack:npm",
    "package:dir": "pnpm build && pnpm --filter @origamix/desktop package:dir:assemble",
    "package": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm --filter @origamix/desktop package:assemble",
    "test:architecture": "node --test scripts/eslint-server-boundaries.test.mjs"
  },
  "keywords": [
    "lowCode",
    "editor",
    "visual config",
    "ai first"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "lefthook"
    ]
  }
}
