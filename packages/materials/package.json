{
  "name": "@origamix/materials",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./antd/manifest": {
      "types": "./dist/public/antd/manifest.d.ts",
      "import": "./dist/public/antd/manifest.js"
    },
    "./antd": {
      "types": "./dist/public/antd/runtime.d.ts",
      "import": "./dist/public/antd/runtime.js"
    },
    "./antd/editor": {
      "types": "./dist/internal/antd/editor.d.ts",
      "import": "./dist/internal/antd/editor.js"
    },
    "./antd/validation": {
      "types": "./dist/public/antd/validation.d.ts",
      "import": "./dist/public/antd/validation.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./antd": {
        "types": "./dist/public/antd/runtime.d.ts",
        "import": "./dist/public/antd/runtime.js"
      },
      "./antd/manifest": {
        "types": "./dist/public/antd/manifest.d.ts",
        "import": "./dist/public/antd/manifest.js"
      },
      "./antd/validation": {
        "types": "./dist/public/antd/validation.d.ts",
        "import": "./dist/public/antd/validation.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm manifest:generate && pnpm typecheck:prepared",
    "test": "pnpm manifest:generate && pnpm test:prepared",
    "build": "pnpm manifest:generate && pnpm build:prepared",
    "pack:npm": "node --import tsx ../../scripts/pack-public.ts materials",
    "prepack": "node -e \"throw new Error('Use pnpm pack:npm to prepare isolated public artifacts')\"",
    "manifest:generate": "node --import tsx scripts/generate-manifest.ts",
    "manifest:watch": "node --import tsx scripts/generate-manifest.ts --watch",
    "manifest:check": "node --import tsx scripts/generate-manifest.ts --check",
    "typecheck:prepared": "tsc --noEmit -p tsconfig.json",
    "test:prepared": "vitest run",
    "build:prepared": "tsdown"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "nanoid": "^6.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "antd": "^6.0.0",
    "react": "^19.2.8",
    "tsdown": "^0.23.3",
    "@origamix/shared": "workspace:*",
    "@origamix/ui": "workspace:*",
    "@origamix/runtime": "workspace:*",
    "tsx": "4.23.13",
    "@types/node": "^24.13.3",
    "prettier": "^3.9.6",
    "lucide-react": "^1.34.0",
    "@origamix/editor": "workspace:*"
  },
  "peerDependencies": {
    "antd": "^6",
    "react": "^19",
    "@origamix/ui": "workspace:*",
    "@origamix/runtime": "^1.0.0",
    "lucide-react": "^1.34.0"
  },
  "peerDependenciesMeta": {
    "@origamix/ui": {
      "optional": true
    }
  }
}
