{
  "name": "@origamix/server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./runtime": {
      "types": "./runtime.ts",
      "default": "./dist/runtime.cjs"
    },
    "./tooling": {
      "types": "./tooling.ts",
      "default": "./dist/tooling.cjs"
    },
    "./utility": "./dist/server.cjs",
    "./build": "./scripts/build.mjs",
    "./development": "./scripts/development.mjs",
    "./template": {
      "types": "./template.ts",
      "default": "./dist/template.cjs"
    },
    "./template-artifact": "./scripts/prepare-template-artifact.mjs"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm --filter @origamix/materials build && pnpm check:database-schema",
    "test": "vitest run",
    "test:template": "pnpm build && node scripts/smoke-template.mjs",
    "test:dev": "node scripts/smoke-development.mjs",
    "probe:deepseek": "pnpm build && node scripts/probe-deepseek.mjs",
    "gate:agent": "pnpm build && node scripts/gate-agent.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "check:database-schema": "node scripts/check-database-schema.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@origamix/materials": "workspace:*",
    "@origamix/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "ajv": "^8.20.0",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.12.1",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "0.31.10",
    "tsup": "^8.5.0"
  }
}
