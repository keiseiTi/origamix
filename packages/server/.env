# Independent Server defaults; Desktop hosts inject their own settings.
# Relative paths use this package directory. Configure credentials privately.
ORIGAMIX_LOCAL_STATE_DIR=../../.origamix-local
ORIGAMIX_LOCAL_PROJECT_DIR=
# Empty means <resolved state directory>/template.
ORIGAMIX_TEMPLATE_DIR=

# Set 0 only when an isolated host needs an OS-assigned port.
ORIGAMIX_SERVER_PORT=1029

# Web Server only. Supply the connection URL privately.
ORIGAMIX_WEB_MYSQL_URL=
