# Independent Server development only; Desktop/Web hosts inject their own settings.
# Relative paths use this package directory. Credentials remain process-injected.
ORIGAMIX_WEB_STATE_DIR=../../.origamix-web
ORIGAMIX_WEB_PROJECT_DIR=
# Empty means <resolved state directory>/template.
ORIGAMIX_TEMPLATE_DIR=

# Set 0 only when an isolated host needs an OS-assigned port.
ORIGAMIX_SERVER_PORT=1029
