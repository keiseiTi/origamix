{
  "name": "origamix",
  "version": "1.0.0",
  "private": true,
  "description": "A low-code agent platform and visual builder",
  "author": "yupeilin <yuchacha250@gmail.com>",
  "scripts": {
    "dev": "node --import tsx scripts/dev-desktop.ts",
    "start:web": "node --import tsx scripts/web.ts",
    "dev:server:web": "pnpm --filter @origamix/server dev:web",
    "start:server:web": "pnpm --filter @origamix/server start:web",
    "dev:web": "node --import tsx scripts/web.ts --development",
    "site": "pnpm --filter @origamix/site dev",
    "site:build": "pnpm --filter @origamix/site build",
    "build": "node --import tsx scripts/build-desktop.ts",
    "build:web": "node --import tsx scripts/build-web.ts",
    "build:libs": "pnpm --filter @origamix/shared --filter @origamix/runtime --filter @origamix/materials build",
    "format": "prettier --write \"{packages,apps,scripts}/**/*.{js,jsx,ts,tsx,cts,json,mjs,css,md}\" \"eslint.config.mjs\"",
    "hooks:install": "lefthook install",
    "hooks:run": "lefthook run pre-commit",
    "lint": "node --import tsx scripts/check.ts lint",
    "typecheck": "node --import tsx scripts/check.ts typecheck",
    "test": "node --import tsx scripts/check.ts test",
    "gate:internal": "node --import tsx scripts/test-integration.ts gate:internal",
    "package:dir": "node --import tsx scripts/package-desktop.ts dir",
    "package": "pnpm package:mac",
    "package:mac": "node --import tsx scripts/package-desktop.ts mac",
    "release:version": "node --import tsx scripts/release-version.ts",
    "pack:npm": "node --import tsx scripts/release.ts pack",
    "test:template": "node --import tsx scripts/test-integration.ts template",
    "test:agent:mysql": "node --import tsx scripts/test-integration.ts agent:mysql",
    "test:web:mysql": "node --import tsx scripts/test-integration.ts web:mysql",
    "test:web": "node --import tsx scripts/test-integration.ts web",
    "test:desktop": "node --import tsx scripts/test-integration.ts desktop",
    "test:dev": "node --import tsx scripts/test-integration.ts dev",
    "release:check": "node --import tsx scripts/release.ts check",
    "publish:npm": "node --import tsx scripts/release.ts publish",
    "release:registry": "node --import tsx scripts/check-registry.ts",
    "build:prepared": "node --import tsx scripts/build-desktop.ts --prepared",
    "typecheck:prepared": "node --import tsx scripts/check.ts typecheck --prepared",
    "test:prepared": "node --import tsx scripts/check.ts test --prepared",
    "check": "node --import tsx scripts/check.ts",
    "build:libs:check": "node --import tsx scripts/check.ts prepare",
    "check:staged": "node --import tsx scripts/check.ts staged"
  },
  "keywords": [
    "lowCode",
    "editor",
    "visual config",
    "ai first"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "tsdown": "^0.23.3",
    "tsx": "4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "type": "module"
}
