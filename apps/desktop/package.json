{
  "name": "@origamix/desktop",
  "version": "1.0.0",
  "description": "Origamix desktop application",
  "author": "yupeilin <yuchacha250@gmail.com>",
  "type": "module",
  "private": true,
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:main": "node test/test-electron.mjs",
    "evaluate:agent": "node test/evaluate-agent.mjs",
    "test:resources": "node test/test-electron.mjs --resources",
    "build": "pnpm --filter @origamix/shared --filter @origamix/runtime --filter @origamix/materials build && pnpm --filter @origamix/server build:assemble && node scripts/build.mjs",
    "build:assemble": "node scripts/build.mjs",
    "package": "pnpm --filter @origamix/app build && pnpm build && pnpm package:assemble",
    "package:dir": "pnpm --filter @origamix/app build && pnpm build && pnpm package:dir:assemble",
    "package:dir:assemble": "electron-builder --config electron-builder.yml --mac --arm64 --dir --publish never",
    "package:assemble": "electron-builder --config electron-builder.yml --mac --arm64 --publish never"
  },
  "dependencies": {
    "@origamix/server": "workspace:*",
    "@origamix/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.0",
    "tsup": "^8.5.0"
  }
}
