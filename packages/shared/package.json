{
  "name": "@origamix/shared",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./credential-gateway": "./src/credential-gateway.ts",
    "./desktop-api": "./src/desktop-api.ts",
    "./page-window": "./src/page-window.ts",
    "./protocol/agent-validation": "./src/protocol/agent-validation.ts",
    "./protocol/agent": "./src/protocol/agent.ts",
    "./protocol/api": "./src/protocol/api.ts",
    "./protocol/project-manifest": "./src/protocol/project-manifest.ts",
    "./protocol/schema": "./src/protocol/schema.ts",
    "./protocol/validation": "./src/protocol/validation.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./credential-gateway": {
        "types": "./dist/credential-gateway.d.mts",
        "import": "./dist/credential-gateway.js"
      },
      "./desktop-api": {
        "types": "./dist/desktop-api.d.mts",
        "import": "./dist/desktop-api.js"
      },
      "./page-window": {
        "types": "./dist/page-window.d.mts",
        "import": "./dist/page-window.js"
      },
      "./protocol/agent-validation": {
        "types": "./dist/protocol/agent-validation.d.mts",
        "import": "./dist/protocol/agent-validation.js"
      },
      "./protocol/agent": {
        "types": "./dist/protocol/agent.d.mts",
        "import": "./dist/protocol/agent.js"
      },
      "./protocol/api": {
        "types": "./dist/protocol/api.d.mts",
        "import": "./dist/protocol/api.js"
      },
      "./protocol/project-manifest": {
        "types": "./dist/protocol/project-manifest.d.mts",
        "import": "./dist/protocol/project-manifest.js"
      },
      "./protocol/schema": {
        "types": "./dist/protocol/schema.d.mts",
        "import": "./dist/protocol/schema.js"
      },
      "./protocol/validation": {
        "types": "./dist/protocol/validation.d.mts",
        "import": "./dist/protocol/validation.js"
      }
    }
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsup",
    "pack:npm": "pnpm pack --pack-destination ../../release/npm"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
