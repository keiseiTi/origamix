{
  "name": "@origamix/materials",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    "./antd/manifest": {
      "types": "./dist/antd/manifest.d.ts",
      "import": "./dist/antd/manifest.js"
    },
    "./antd/runtime": {
      "types": "./dist/antd/runtime.d.ts",
      "import": "./dist/antd/runtime.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./antd/editor": {
      "types": "./dist/antd/editor.d.ts",
      "import": "./dist/antd/editor.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "tsup",
    "pack:npm": "pnpm pack --pack-destination ../../release/npm"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "antd": "^6.0.0",
    "react": "^19.2.8",
    "tsup": "^8.5.0",
    "@origamix/shared": "workspace:*",
    "@origamix/ui": "workspace:*",
    "@origamix/runtime": "workspace:*"
  },
  "peerDependencies": {
    "antd": "^6",
    "react": "^19",
    "@origamix/ui": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@origamix/ui": {
      "optional": true
    }
  }
}
