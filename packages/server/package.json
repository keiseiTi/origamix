{
  "name": "@origamix/server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./web-runtime": {
      "types": "./src/hosts/mysql-web-server.ts",
      "default": "./dist/web-runtime.cjs"
    },
    "./model-catalog": {
      "types": "./src/agent/pi-runtime.ts",
      "default": "./dist/model-catalog.cjs"
    },
    "./runtime": {
      "types": "./src/server.ts",
      "default": "./dist/runtime.cjs"
    },
    "./tooling": {
      "types": "./src/tooling.ts",
      "default": "./dist/tooling.cjs"
    },
    "./utility": "./dist/server.cjs",
    "./build": "./scripts/build.ts",
    "./template-artifact": {
      "types": "./scripts/prepare-template-artifact.ts",
      "default": "./scripts/prepare-template-artifact.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm check:database-schema && pnpm test:architecture && vitest run --exclude test/eslint-boundaries.test.ts",
    "test:architecture": "node --import tsx --test test/eslint-boundaries.test.ts",
    "test:agent:mysql": "node --import tsx test/test-mysql-agent.ts",
    "test:template": "node --import tsx test/test-template.ts",
    "test:dev": "node --import tsx test/test-development.ts",
    "gate:agent": "node --import tsx scripts/gate-agent.ts",
    "build": "node --import tsx scripts/build.ts",
    "dev:web": "node --import tsx scripts/dev.ts --web",
    "start:web": "node --import tsx scripts/web-worker.ts",
    "build:template": "node --import tsx scripts/build-template.ts",
    "dev": "node --import tsx scripts/dev.ts",
    "check:database-schema": "node --import tsx scripts/check-database-schema.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@origamix/materials": "workspace:*",
    "@origamix/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "ajv": "^8.20.0",
    "drizzle-orm": "1.0.0-rc.5",
    "fastify": "^5.12.1",
    "fflate": "0.8.2",
    "mysql2": "^3.24.6",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.5",
    "eslint": "^10.9.0",
    "tsdown": "^0.23.3",
    "tsx": "4.23.13",
    "typescript-eslint": "^8.67.0"
  }
}
